---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav" id="nav">
  <div class="nav__inner wrap">
    <a href="/" class="brand" aria-label={`${site.name} — home`} id="nav-home">
      <span class="brand__mark" aria-hidden="true">
        <span class="c"></span><span class="s"></span>
      </span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__links">
        {nav.map((n) => (
          <li>
            <a
              href={n.href}
              id={`nav-${n.label.toLowerCase()}`}
              class:list={['nav__link', { active: n.href !== '/#work' && n.href !== '/#contact' && path.startsWith(n.href) }]}
            >{n.label}</a>
          </li>
        ))}
        <li><a href={site.cv} class="nav__cv" id="nav-cv" target="_blank" rel="noopener">CV <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>

    <span class="status mono" aria-label="Status: open to opportunities">
      <span class="status__led"></span> Open to work
    </span>
  </div>
</header>

<script>
  const nav = document.getElementById('nav');
  let last = 0;
  addEventListener('scroll', () => {
    const y = scrollY;
    nav?.classList.toggle('nav--scrolled', y > 12);
    nav?.classList.toggle('nav--hidden', y > 240 && y > last);
    last = y;
  }, { passive: true });
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    transition: transform .5s var(--ease), background .3s, border-color .3s;
    border-bottom: 1px solid transparent;
  }
  .nav--scrolled {
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    border-color: var(--line);
  }
  .nav--hidden { transform: translateY(-100%); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 1rem; }

  .brand { display: inline-flex; align-items: center; gap: .7rem; font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; }
  .brand__mark { position: relative; width: 26px; height: 26px; }
  .brand__mark .c { position: absolute; inset: 0 8px 8px 0; border-radius: 50%; background: var(--signal); transition: transform .6s var(--ease); }
  .brand__mark .s { position: absolute; inset: 9px 0 0 9px; background: var(--ink); mix-blend-mode: multiply; transition: transform .6s var(--ease); }
  .brand:hover .c { transform: translate(3px, 3px); }
  .brand:hover .s { transform: translate(-3px, -3px) rotate(90deg); }

  .nav__links { display: flex; align-items: center; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  .nav__link, .nav__cv {
    display: inline-block; padding: .5rem .9rem; border-radius: 999px;
    font-size: var(--fs-sm); font-weight: 500; color: var(--ink-2);
    transition: background .25s, color .25s;
  }
  .nav__link:hover, .nav__link.active { background: var(--paper-2); color: var(--ink); }
  .nav__cv { border: 1px solid var(--line-strong); margin-left: .35rem; }
  .nav__cv:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .status { display: inline-flex; align-items: center; gap: .5rem; font-size: var(--fs-xs); color: var(--mute); text-transform: uppercase; letter-spacing: .08em; }
  .status__led { width: 8px; height: 8px; border-radius: 50%; background: #3bb36b; box-shadow: 0 0 0 3px rgba(59,179,107,.18); animation: pulse 2.4s infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 6px rgba(59,179,107,0); } }

  @media (max-width: 820px) {
    .status { display: none; }
    .brand__name { display: none; }
  }
  @media (max-width: 420px) {
    .nav__link, .nav__cv { padding: .45rem .6rem; }
  }
</style>
