        },
        "tagline": {
          "type": "string"
        },
        "course": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "repo": {
          "type": "string",
